# ───────────────────────────── The Graph ─────────────────────────────
# Subgraph Studio API key (https://thegraph.com/studio/apikeys/). Used for every
# Messari standardized-subgraph query through the decentralized gateway.
GRAPH_API_KEY=

# Optional: Substreams token for the live whale wire (Pinax or StreamingFast).
# Without it the stream endpoint falls back to polling the standardized subgraphs.
SUBSTREAMS_API_TOKEN=
SUBSTREAMS_ENDPOINT=https://eth.substreams.pinax.network:443

# ───────────────────────────── Hedera ────────────────────────────────
HEDERA_NETWORK=testnet
# Service wallet (receives x402 payments, signs HCS audit messages). Portal keys can be ECDSA or ED25519.
HEDERA_SERVICE_ACCOUNT_ID=0.0.XXXXX
HEDERA_SERVICE_PRIVATE_KEY=0x...
HEDERA_SERVICE_KEY_TYPE=ecdsa
# Agent wallet (pays for data). Must differ from the service account. Create one with `pnpm hedera:agent-account`.
HEDERA_AGENT_ACCOUNT_ID=0.0.YYYYY
HEDERA_AGENT_PRIVATE_KEY=0x...
HEDERA_AGENT_KEY_TYPE=ecdsa
# HCS topics for verifiable payment audit trails (create with `pnpm hedera:topics`)
HCS_SERVICE_TOPIC_ID=
HCS_AGENT_TOPIC_ID=

# x402 facilitator (Blocky402). Testnet needs no API key.
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# ───────────────────────────── Service ───────────────────────────────
PORT=4021
# Public base URL of the service (what gets written into ENS records)
SERVICE_URL=http://localhost:4021

# ───────────────────────────── Agent ─────────────────────────────────
# Any OpenAI-compatible endpoint (vLLM, Ollama, OpenRouter, DashScope, ...). Model: Qwen 3.8.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen3.8-27B
# Hard spending cap for one agent run, in HBAR
AGENT_BUDGET_HBAR=1

# ───────────────────────────── Render (optional hosting) ─────────────
# `pnpm render:deploy` triggers + waits for a deploy of main (auto-deploy needs Render's GitHub app)
RENDER_API_KEY=
RENDER_SERVICE_ID=

# ───────────────────────────── ENSv2 (Sepolia) ───────────────────────
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Deployer / namespace admin key (needs Sepolia ETH). MockUSDC is minted for free.
ENS_DEPLOYER_PRIVATE_KEY=0x...
# The .eth name you will register on ENSv2 Sepolia (label only, no ".eth")
ENS_PARENT_LABEL=rugradar
# Written by `pnpm ens:deploy` into ens.deployment.json; env overrides win.
ENS_USER_REGISTRY=
ENS_RESOLVER=
ENS_DEPLOY_BLOCK=
# Name the agent resolves to discover the paid API
ENS_SERVICE_NAME=api.rugradar.eth
# EVM key that represents the *service* in ENS (owns its subname, may edit only x402.pricing via EAC).
# Any secp256k1 key; generated once. Funded automatically with 0.01 Sepolia ETH by ens:service-update.
ENS_SERVICE_EVM_PRIVATE_KEY=0x...
